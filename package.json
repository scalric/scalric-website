{
  "name": "scalric-corporate-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "vite --config vite.config.js --configLoader runner",
    "dev:api": "node backend/server.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:import-sqlite": "node database/import-sqlite.js",
    "build": "vite build --config vite.config.js --configLoader runner",
    "preview": "vite preview --config vite.config.js --configLoader runner",
    "start": "node backend/server.js"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  }
}
